{
  "name": "emdash-mika-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local:build": "node scripts/build-local-packages.mjs",
    "predev": "npm run local:build",
    "dev": "astro dev",
    "prebuild": "npm run local:build",
    "build": "astro build",
    "start": "node scripts/start-production.mjs",
    "prepreview": "npm run local:build",
    "preview": "astro preview",
    "astro": "astro",
    "preseed:apply": "npm run local:build",
    "seed:apply": "node scripts/seed-fixture.mjs",
    "pretypecheck": "npm run local:build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run local:build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "postinstall": "node scripts/patch-emdash-dev-bypass.mjs",
    "fixture:reset": "node scripts/reset-fixture.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.0",
    "@astrojs/react": "^6.0.2",
    "@bnomei/emdash-actions": "^0.4.1",
    "@bnomei/emdash-mika": "file:vendor/bnomei-emdash-mika-0.1.0.tgz",
    "@cloudflare/kumo": "^2.5.2",
    "@phosphor-icons/react": "^2.1.10",
    "astro": "^7.2.0",
    "better-sqlite3": "^12.11.1",
    "emdash": "^0.32.0",
    "image-size": "2.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "emdash": {
    "seed": "seed/mika-actions.seed.json"
  },
  "imports": {
    "#mika-template-plugin": "./src/plugins/mika-template-plugin.ts"
  }
}
