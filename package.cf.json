{
  "name": "emdash-mika-template-cloudflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local:build": "node scripts/build-local-packages.mjs",
    "predev": "npm run local:build",
    "dev": "astro dev",
    "prebuild": "npm run local:build",
    "build": "astro build",
    "predeploy": "npm run local:build",
    "deploy": "astro build && wrangler deploy",
    "prepreview": "npm run local:build",
    "preview": "astro preview",
    "astro": "astro",
    "pretypecheck": "npm run local:build",
    "typecheck": "astro check && tsc --noEmit",
    "pretest": "npm run local:build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "postinstall": "node scripts/patch-emdash-dev-bypass.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@bnomei/emdash-actions": "^0.4.1",
    "@bnomei/emdash-mika": "file:vendor/bnomei-emdash-mika-0.2.0.tgz",
    "@cloudflare/kumo": "2.6.0",
    "@emdash-cms/cloudflare": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "astro": "^7.3.8",
    "emdash": "^1.2.0",
    "image-size": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "emdash": {
    "seed": "seed/mika-actions.seed.json"
  },
  "imports": {
    "#mika-template-plugin": "./src/plugins/mika-template-plugin.ts"
  }
}
