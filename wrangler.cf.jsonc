{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emdash-mika-template",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emdash-mika-template",
      // Run `wrangler d1 create emdash-mika-template` and replace this before deploy.
      "database_id": "local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "emdash-mika-template-media"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ]
}
