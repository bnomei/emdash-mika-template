{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Mika Actions Template",
    "description": "Resettable peanut-themed EmDash seed for testing Mika action fields across catalog, session, account, ledger, and ops records.",
    "author": "emdash-mika-template"
  },
  "settings": {
    "title": "Mika Actions Template",
    "tagline": "Local action runner smoke project",
    "postsPerPage": 12,
    "dateFormat": "yyyy-MM-dd",
    "timezone": "Europe/Dublin",
    "seo": {
      "titleSeparator": " | "
    }
  },
  "collections": [
    {
      "slug": "products",
      "label": "Products",
      "labelSingular": "Product",
      "description": "Catalog products with variants and catalog sync actions.",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search"
      ],
      "urlPattern": "/products/{slug}",
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "text",
          "searchable": true
        },
        {
          "slug": "commerce_ref",
          "label": "Commerce reference",
          "type": "json"
        },
        {
          "slug": "variants",
          "label": "Variants",
          "type": "json"
        },
        {
          "slug": "mika_catalog_sync",
          "label": "Sync commerce",
          "type": "json",
          "widget": "actions:button",
          "options": {
            "mode": "run",
            "provider": "mika",
            "providerLabel": "Mika",
            "manifestRoute": ".well-known/actions",
            "runnerRoute": ".well-known/actions/run",
            "action": "mika.catalog.syncEntry",
            "contextKey": "context",
            "label": "Sync commerce",
            "cooldownMs": 3500,
            "icon": "refresh",
            "tone": "info",
            "payload": {
              "mode": "dry_run",
              "scope": "entry"
            },
            "feedback": {
              "progress": "Syncing commerce data...",
              "success": "Commerce data synced.",
              "error": "Commerce sync failed."
            }
          }
        }
      ]
    },
    {
      "slug": "stock_items",
      "label": "Stock Items",
      "labelSingular": "Stock Item",
      "description": "Stock records for adjustment and reservation tests.",
      "supports": [
        "drafts",
        "revisions",
        "search"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "stock_ref",
          "label": "Stock reference",
          "type": "json"
        },
        {
          "slug": "quantities",
          "label": "Quantities",
          "type": "json"
        },
        {
          "slug": "stock_adjust",
          "label": "Adjust stock",
          "type": "json",
          "widget": "actions:button",
          "options": {
            "mode": "run",
            "provider": "mika",
            "providerLabel": "Mika",
            "manifestRoute": ".well-known/actions",
            "runnerRoute": ".well-known/actions/run",
            "action": "mika.stock.adjust",
            "contextKey": "context",
            "label": "Adjust stock",
            "cooldownMs": 3500,
            "icon": "plus-minus",
            "tone": "warning",
            "confirm": "Adjust stock for this fixture item?",
            "payload": {
              "quantityDelta": 1,
              "reason": "fixture_adjustment"
            },
            "feedback": {
              "progress": "Adjusting stock...",
              "success": "Stock adjusted.",
              "error": "Stock adjustment failed."
            }
          }
        }
      ]
    },
    {
      "slug": "customers",
      "label": "Customers",
      "labelSingular": "Customer",
      "description": "Fake customers and provider customer refs.",
      "supports": [
        "drafts",
        "revisions",
        "search"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Name",
          "type": "string",
          "required": true,
          "searchable": true
