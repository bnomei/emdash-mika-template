---
import { Badge, Link, Text } from "@cloudflare/kumo";
import CheckoutSteps from "../../components/CheckoutSteps.astro";
import MikaKumoPage from "../../components/MikaKumoPage.astro";
import { mikaTemplateCheckoutCancelView } from "../../lib/checkout-cancel";
import { mikaTemplateRoutes } from "../../lib/routes";
import { mikaTemplateStatusLabel, mikaTemplateStatusVariant } from "../../lib/display";

export const prerender = false;

const { checkoutId, status, cartItemCount } = await mikaTemplateCheckoutCancelView(Astro);
---

<MikaKumoPage title="Checkout cancelled" pageSize="narrow" cartItemCount={cartItemCount} data-mika-checkout-cancel>
  <CheckoutSteps current="checkout" />

  <section class="mika-kumo-panel mika-kumo-stack">
    <div class="mika-kumo-title-row">
      <Text as="h2" variant="heading2">No payment was completed</Text>
      {checkoutId && (
        <Badge appearance="dot" variant={mikaTemplateStatusVariant(status)}>
          {mikaTemplateStatusLabel(status)}
        </Badge>
      )}
    </div>
    <Text as="p" variant="secondary">
      Your cart is still the place to review quantities, apply a coupon, save items for later, or start checkout again.
    </Text>

    <div class="mika-kumo-actions">
      <Link href={mikaTemplateRoutes.cart}>Return to cart</Link>
      <Link href={mikaTemplateRoutes.products}>Continue shopping</Link>
      <Link href={mikaTemplateRoutes.wishlist}>Wishlist</Link>
    </div>
  </section>
</MikaKumoPage>
