---
/**
 * Route: `/checkout/cancel`
 * Landing for abandoned checkout with optional checkout status display.
 * Boundary: no payment capture; cart and catalog links remain available.
 */
import { Badge, Banner, Link, Text } from "@cloudflare/kumo";
import CheckoutSteps from "../../components/CheckoutSteps.astro";
import MikaKumoPage from "../../components/MikaKumoPage.astro";
import { mikaTemplateCheckoutCancelView } from "../../lib/checkout-cancel";
import { mikaTemplateRoutes } from "../../lib/routes";
import { mikaTemplateStatusLabel, mikaTemplateStatusVariant } from "../../lib/display";

export const prerender = false;

const { checkoutId, status, orderId, lookupError, cartItemCount } = await mikaTemplateCheckoutCancelView(Astro);
const statusMessage =
  status === "missing"
    ? "Checkout cancel link is missing. Your cart is still available if you were reviewing an order."
    : lookupError
      ? "Checkout cancellation could not be verified. Your cart is still available if no payment was completed."
      : status === "completed"
        ? "Payment was completed before this cancellation could be applied."
        : "No payment was confirmed by this return page.";
---

<MikaKumoPage title="Checkout cancelled" pageSize="narrow" cartItemCount={cartItemCount} data-mika-checkout-cancel>
  <CheckoutSteps current="checkout" />

  <section class="mika-kumo-panel mika-kumo-stack">
    <div class="mika-kumo-title-row">
      <Text as="h2" variant="heading2">No payment was completed</Text>
      {checkoutId && (
        <Badge appearance="dot" variant={mikaTemplateStatusVariant(status)}>
          {mikaTemplateStatusLabel(status)}
        </Badge>
      )}
    </div>
    {lookupError && <Banner variant="error" title="Checkout lookup failed" description={lookupError} role="alert" />}
    <Text as="p" variant="secondary">
      {statusMessage}
    </Text>

    <div class="mika-kumo-actions">
      {orderId && <Link href={`${mikaTemplateRoutes.accountOrders}#order-${orderId}`}>View order</Link>}
      <Link href={mikaTemplateRoutes.cart}>Return to cart</Link>
      <Link href={mikaTemplateRoutes.products}>Continue shopping</Link>
      <Link href={mikaTemplateRoutes.wishlist}>Wishlist</Link>
    </div>
  </section>
</MikaKumoPage>
