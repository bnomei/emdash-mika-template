---
const checks = [
  { label: "Admin", href: "/_emdash/admin" },
  { label: "Action contract JSON", href: "/api/mika-action-contract.json" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mika Actions Template</title>
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #1d1b16;
        background: #fbfaf7;
      }

      body {
        margin: 0;
      }

      main {
        width: min(880px, calc(100% - 40px));
        margin: 56px auto;
      }

      h1 {
        margin: 0 0 12px;
        font-size: 32px;
        line-height: 1.15;
        letter-spacing: 0;
      }

      p {
        max-width: 680px;
        margin: 0 0 24px;
        color: #5e574b;
        line-height: 1.6;
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      a {
        display: inline-flex;
        align-items: center;
        min-height: 40px;
        padding: 0 14px;
        border: 1px solid #cfc7b8;
        border-radius: 6px;
        color: #1d1b16;
        text-decoration: none;
        background: #ffffff;
      }

      a:hover {
        border-color: #80786b;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Mika Actions Template</h1>
      <p>
        A local EmDash app wired to the Mika admin action runner. Apply the seed, open the
        admin, and use the product entry fields to smoke-test collection and JSON-model actions.
      </p>
      <nav aria-label="Smoke checks">
        {checks.map((check) => <a href={check.href}>{check.label}</a>)}
      </nav>
    </main>
  </body>
</html>
