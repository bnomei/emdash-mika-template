---
import { Badge, Link, Text } from "@cloudflare/kumo";
import MikaKumoPage from "../components/MikaKumoPage.astro";
import { mikaTemplateCurrentCartItemCount } from "../lib/cart";
import { templateProductSummaries } from "../lib/mika-api";

const products = templateProductSummaries();
const cartItemCount = await mikaTemplateCurrentCartItemCount(Astro);
---

<MikaKumoPage
  title="Mika Storefront Template"
  description="A runnable Astro and EmDash storefront starter with Mika product forms, cart, wishlist, checkout, account surfaces, agent-readable metadata, and the admin action fixture in one resettable app."
  cartItemCount={cartItemCount}
>
  <section class="mika-kumo-grid" aria-label="Products">
    {products.map((product) => (
      <article class="mika-kumo-card">
        <div class="mika-kumo-stack">
          <Text as="h2" variant="heading3">
            <Link href={product.href}>{product.title}</Link>
          </Text>
          <Text as="p" variant="secondary">{product.description}</Text>
          <div class="mika-kumo-meta-row">
            <Badge variant="secondary">{product.priceLabel}</Badge>
            <span class="mika-kumo-muted">{product.variantCount} variants</span>
          </div>
        </div>
      </article>
    ))}
  </section>
</MikaKumoPage>
