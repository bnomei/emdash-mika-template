---
/**
 * Route: `/account/orders`
 * Customer order history with optional `?invoice=` invoice lookup.
 * Boundary: Mika session required; magic-link sign-in when unauthenticated.
 */
import { actions, isInputError } from "astro:actions";
import { Banner, Link } from "@cloudflare/kumo";
import { createMika } from "@bnomei/emdash-mika/astro";
import AccountOrders from "../../components/AccountOrders.astro";
import AccountSignInPanel from "../../components/AccountSignInPanel.astro";
import MikaKumoPage from "../../components/MikaKumoPage.astro";
import { mikaTemplateCurrentCartItemCount } from "../../lib/cart";
import { mikaApiOverrides } from "../../lib/mika-api";
import { mikaTemplateRoutes } from "../../lib/routes";

export const prerender = false;

const Mika = createMika(Astro, { api: mikaApiOverrides });
const magicLinkResult = Astro.getActionResult(actions.mika.magicLink.request);
const magicLinkInputErrors = isInputError(magicLinkResult?.error)
  ? magicLinkResult.error.fields
  : {};
const magicLinkError = isInputError(magicLinkResult?.error)
  ? null
  : magicLinkResult?.error?.message;
const invoiceOrderId = Astro.url.searchParams.get("invoice");
const invoiceResult = invoiceOrderId ? await Mika.order.invoice(invoiceOrderId) : null;
const accountResult = await Mika.account.get();
const account = accountResult.ok ? accountResult.data : null;
const accountLoadError =
  !accountResult.ok && accountResult.error.code !== "AUTH_REQUIRED"
    ? accountResult.error.message
    : null;
const cartItemCount = await mikaTemplateCurrentCartItemCount(Astro);
---

<MikaKumoPage title="Orders" pageSize="narrow" cartItemCount={cartItemCount} data-mika-account-orders-page>
  {!account ? (
    <AccountSignInPanel
      returnTo={mikaTemplateRoutes.accountOrders}
      accountLoadError={accountLoadError}
      magicLinkSent={magicLinkResult?.data?.sent}
      magicLinkError={magicLinkError}
      emailError={magicLinkInputErrors.email?.join(", ")}
    />
  ) : (
    <section class="mika-kumo-panel mika-kumo-stack">
      {invoiceResult?.ok && (
        <Banner variant="default" title="Invoice ready">
          <Link href={invoiceResult.data.href}>Open invoice for {invoiceResult.data.orderId}</Link>
        </Banner>
      )}
      {invoiceResult && !invoiceResult.ok && (
        <Banner variant="error" title="Invoice unavailable" description={invoiceResult.error.message} role="alert" />
      )}
      <AccountOrders orders={account.orders} />
    </section>
  )}
</MikaKumoPage>
