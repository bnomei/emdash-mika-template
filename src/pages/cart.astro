---
/**
 * Route: `/cart`
 * Cart review, line edits, coupons, and checkout initiation.
 * Boundary: Mika cart state; checkout-start action may redirect to payment provider.
 */
import { actions, isInputError } from "astro:actions";
import { mikaActionResult } from "../components/mikaActionResult";
import { Badge, Banner, Link, Text } from "@cloudflare/kumo";
import { createMika } from "@bnomei/emdash-mika/astro";
import BuyerAssurance from "../components/BuyerAssurance.astro";
import CartLines from "../components/CartLines.astro";
import CheckoutSteps from "../components/CheckoutSteps.astro";
import CartSummary from "../components/CartSummary.astro";
import CheckoutForm from "../components/CheckoutForm.astro";
import CouponForm from "../components/CouponForm.astro";
import MikaKumoPage from "../components/MikaKumoPage.astro";
import { mikaTemplateCartCheckoutIssues, mikaTemplateCartItemCount, mikaTemplatePlural } from "../lib/display";
import { mikaApiOverrides } from "../lib/mika-api";
import { mikaTemplateRoutes } from "../lib/routes";

export const prerender = false;

const Mika = createMika(Astro, { api: mikaApiOverrides });

const checkoutResult = mikaActionResult(Astro.getActionResult(actions.mika.checkout.start));
if (checkoutResult?.data?.redirectUrl) {
  return Astro.redirect(checkoutResult.data.redirectUrl);
}

const updateResult = mikaActionResult(Astro.getActionResult(actions.mika.cart.update));
const removeResult = mikaActionResult(Astro.getActionResult(actions.mika.cart.remove));
const couponApplyResult = mikaActionResult(Astro.getActionResult(actions.mika.cart.applyCoupon));
const couponRemoveResult = mikaActionResult(Astro.getActionResult(actions.mika.cart.removeCoupon));
const saveForLaterResult = mikaActionResult(Astro.getActionResult(actions.mika.wishlist.saveForLater));
const checkoutInputErrors = isInputError(checkoutResult?.error) ? checkoutResult.error.fields : {};
const checkoutError = isInputError(checkoutResult?.error) ? null : checkoutResult?.error?.message;
const actionError =
  checkoutError ??
  updateResult?.error?.message ??
  removeResult?.error?.message ??
  couponApplyResult?.error?.message ??
  couponRemoveResult?.error?.message ??
  saveForLaterResult?.error?.message;
const cartResult = await Mika.cart.get();
const cart = cartResult.ok ? cartResult.data : null;
const error = actionError ?? null;
const lineCount = cart?.items.length ?? 0;
const itemCount = mikaTemplateCartItemCount(cart);
const checkoutIssues = mikaTemplateCartCheckoutIssues(cart);
const actionStatus = updateResult?.data
  ? "Cart quantity updated."
  : removeResult?.data
    ? "Item removed from cart."
    : couponApplyResult?.data
      ? "Discount applied."
      : couponRemoveResult?.data
        ? "Discount removed."
        : saveForLaterResult?.data
          ? "Item saved for later."
          : null;
---

<MikaKumoPage title="Cart" cartItemCount={itemCount} data-mika-cart-page>
  <CheckoutSteps current="cart" />
  {lineCount > 0 ? (
    <section class="mika-kumo-cart-layout" aria-label="Cart review and checkout">
      <section class="mika-kumo-panel mika-kumo-stack mika-kumo-cart-items-panel">
        <div class="mika-kumo-title-row">
          <div>
            <Text as="h2" variant="heading2">Review items</Text>
            <Text as="p" variant="secondary" size="sm">
              Update quantities or save items for later before checkout.
            </Text>
          </div>
          <div class="mika-kumo-kicker">
            <Badge variant="secondary">{mikaTemplatePlural(lineCount, "line")}</Badge>
            <Badge variant="secondary">{mikaTemplatePlural(itemCount, "item")}</Badge>
          </div>
        </div>
        {actionStatus && <Banner variant="default" title={actionStatus} role="status" />}
        {error && <Banner variant="error" title="Cart action failed" description={error} role="alert" />}
        <CartLines
          cart={cart}
          updateLabel="Update"
          saveForLaterLabel="Save for later"
        />
        <Link href={mikaTemplateRoutes.products}>Continue shopping</Link>
      </section>

      <aside class="mika-kumo-panel mika-kumo-stack mika-kumo-cart-checkout-panel" aria-label="Order summary">
        <div class="mika-kumo-stack mika-kumo-stack-tight">
          <Text as="h2" variant="heading2">Order summary</Text>
          <Text as="p" variant="secondary" size="sm">
            Totals update after cart changes.
          </Text>
        </div>
        <CartSummary cart={cart} />
        <CouponForm cart={cart} codeLabel="Discount code" applyLabel="Apply discount" />
        <CheckoutForm
          cart={cart}
          class="mika-kumo-checkout-form"
          checkoutIssues={checkoutIssues}
          emailError={checkoutInputErrors.email?.join(", ")}
          nameError={checkoutInputErrors.name?.join(", ")}
          companyError={checkoutInputErrors.company?.join(", ")}
          vatIdError={checkoutInputErrors.vatId?.join(", ")}
        />
        <BuyerAssurance
          title="Before checkout"
          items={[
            { title: "Provider confirmation", description: "The order is paid only after checkout status returns confirmed." },
            { title: "Account fulfillment", description: "Downloads, licenses, and subscriptions stay organized after purchase." },
            { title: "Editable cart", description: "Quantities, discounts, and saved items can be changed before checkout." },
          ]}
        />
      </aside>
    </section>
  ) : (
    <section class="mika-kumo-panel mika-kumo-stack mika-kumo-empty-cart">
      <CartLines cart={cart} />
      {error && <Banner variant="error" title="Cart action failed" description={error} role="alert" />}
      <div class="mika-kumo-actions">
        <Link href={mikaTemplateRoutes.products}>Browse products</Link>
      </div>
    </section>
  )}
</MikaKumoPage>
