---
/**
 * Route: `/download/:token`
 * GET renders a user-confirmed download interstitial; POST resolves the token via
 * `actions.mika.download.confirm` so scanners and previews do not consume links.
 */
import { actions } from "astro:actions";
import { mikaActionResult } from "../../components/mikaActionResult";
import { Button, Text } from "@cloudflare/kumo";
import { mikaHiddenInput } from "@bnomei/emdash-mika/astro";
import MikaKumoPage from "../../components/MikaKumoPage.astro";
import { api } from "../../lib/mika-api";
import { mikaTemplateCurrentCartItemCount } from "../../lib/cart";

export const prerender = false;

const token = Astro.params.token;
const confirmResult = mikaActionResult(Astro.getActionResult(actions.mika.download.confirm));

if (confirmResult?.data?.redirectUrl) {
  return Astro.redirect(confirmResult.data.redirectUrl);
}

const confirmError = confirmResult?.error?.message ?? null;
const resolution = token ? await api.download.resolve({ token }) : undefined;
const deliveryReady = resolution?.ok === true && Boolean(resolution.data.redirectUrl);
const deliveryError =
  resolution?.ok === false
    ? resolution.error.message
    : resolution?.ok === true && resolution.data.downloadRef && !resolution.data.redirectUrl
      ? "Private download delivery is not configured. Contact support."
      : null;
const cartItemCount = await mikaTemplateCurrentCartItemCount(Astro);
---

<MikaKumoPage title="Download" pageSize="narrow" cartItemCount={cartItemCount} data-mika-download-page>
  <section class="mika-kumo-panel mika-kumo-stack">
    {confirmError && <Text as="p" variant="error" role="alert">{confirmError}</Text>}
    {deliveryError && <Text as="p" variant="error" role="alert">{deliveryError}</Text>}

    {token && deliveryReady ? (
      <>
        <Text as="p">Your download is ready. Select continue to start it.</Text>
        <form class="mika-kumo-form" action={actions.mika.download.confirm.queryString} method="post">
          <input type="hidden" {...mikaHiddenInput("token", token)} />
          <Button type="submit" variant="primary">Download</Button>
        </form>
      </>
    ) : !token ? (
      <Text as="p" variant="error" role="alert">Missing download token.</Text>
    ) : null}
  </section>
</MikaKumoPage>
