---
import { Badge, Empty, Link, Table, Text } from "@cloudflare/kumo";
import type { OrderSummaryDTO } from "@bnomei/emdash-mika/types";
import { formatMikaMoney } from "@bnomei/emdash-mika/astro";
import {
  mikaTemplateDateLabel,
  mikaTemplateStatusLabel,
  mikaTemplateStatusVariant
} from "../lib/display";
import { mikaTemplateRoutes } from "../lib/routes";

interface Props {
  orders: readonly OrderSummaryDTO[];
  orderHref?: (order: OrderSummaryDTO) => string | undefined;
  headingLabel?: string;
  emptyLabel?: string;
  invoiceLabel?: string;
  orderLabel?: string;
  statusLabel?: string;
  totalLabel?: string;
  fulfillmentLabel?: string;
  downloadsHref?: string;
  licensesHref?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  orders,
  orderHref,
  headingLabel = "Orders",
  emptyLabel = "No orders yet.",
  invoiceLabel = "Invoice",
  orderLabel = "Order",
  statusLabel = "Status",
  totalLabel = "Total",
  fulfillmentLabel = "Fulfillment",
  downloadsHref = mikaTemplateRoutes.accountDownloads,
  licensesHref = mikaTemplateRoutes.accountLicenses,
  class: className,
  ...attrs
} = Astro.props;
const hasEmptySlot = Astro.slots.has("empty");
---

<section {...attrs} data-mika-account-orders class:list={["mika-kumo-stack", className]}>
  <div class="mika-kumo-stack mika-kumo-stack-tight">
    <Text as="h2" variant="heading2"><slot name="heading">{headingLabel}</slot></Text>
    <Text as="p" variant="secondary">Track payment status, totals, invoices, and where fulfilled files or licenses will appear.</Text>
  </div>
  {orders.length ? (
    <div class="mika-kumo-table-scroll">
      <Table>
        <Table.Header>
          <Table.Row>
            <Table.Head>{orderLabel}</Table.Head>
            <Table.Head>{statusLabel}</Table.Head>
            <Table.Head>{totalLabel}</Table.Head>
            <Table.Head>{fulfillmentLabel}</Table.Head>
            <Table.Head>Actions</Table.Head>
          </Table.Row>
        </Table.Header>
        <Table.Body>
          {orders.map((order) => {
            const href = orderHref?.(order);
            return (
              <Table.Row id={`order-${order.id}`}>
                <Table.Cell className="mika-kumo-table-cell mika-kumo-table-cell-primary" data-label={orderLabel}>
                  <div class="mika-kumo-stack mika-kumo-stack-tight">
                    {href ? (
                      <Link href={href}>{order.orderNumber}</Link>
                    ) : (
                      <strong>{order.orderNumber}</strong>
                    )}
                    <time class="mika-kumo-muted" datetime={order.createdAt}>{mikaTemplateDateLabel(order.createdAt)}</time>
                  </div>
                </Table.Cell>
                <Table.Cell className="mika-kumo-table-cell" data-label={statusLabel}>
                  <div class="mika-kumo-actions">
                    <Badge appearance="dot" variant={mikaTemplateStatusVariant(order.status)}>
                      {mikaTemplateStatusLabel(order.status)}
                    </Badge>
                    <Badge appearance="dot" variant={mikaTemplateStatusVariant(order.paymentStatus)}>
                      Payment {mikaTemplateStatusLabel(order.paymentStatus).toLowerCase()}
                    </Badge>
                  </div>
                </Table.Cell>
                <Table.Cell className="mika-kumo-table-cell" data-label={totalLabel}>
                  <span class="mika-kumo-strong">{formatMikaMoney(order.total)}</span>
                </Table.Cell>
                <Table.Cell className="mika-kumo-table-cell" data-label={fulfillmentLabel}>
                  <div class="mika-kumo-actions">
                    <Link href={downloadsHref}>Downloads</Link>
                    <Link href={licensesHref}>Licenses</Link>
                  </div>
                </Table.Cell>
                <Table.Cell className="mika-kumo-table-cell" data-label="Actions">
                  {order.invoiceUrl ? <Link href={order.invoiceUrl}>{invoiceLabel}</Link> : <span class="mika-kumo-muted">Invoice pending</span>}
                </Table.Cell>
              </Table.Row>
            );
          })}
        </Table.Body>
      </Table>
    </div>
  ) : hasEmptySlot ? (
    <slot name="empty" />
  ) : (
    <Empty size="sm" title={emptyLabel} description="Completed purchases will appear here with receipts and fulfillment links." />
  )}
</section>
