---
import { actions } from "astro:actions";
import { Badge, Button, Input, Text } from "@cloudflare/kumo";
import type { CartDTO } from "@bnomei/emdash-mika/types";
import { mikaReturnTo } from "@bnomei/emdash-mika/astro";
import { mikaHiddenInput, mikaReturnToInput } from "../lib/form";

interface Props {
  cart?: CartDTO | null;
  returnTo?: string;
  codeLabel?: string;
  applyLabel?: string;
  removeLabel?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  cart,
  returnTo = mikaReturnTo(Astro.url),
  codeLabel = "Coupon code",
  applyLabel = "Apply",
  removeLabel = "Remove coupon",
  class: className,
  ...attrs
} = Astro.props;
---

<div {...attrs} data-mika-coupon class:list={["mika-kumo-stack mika-kumo-coupon-panel", className]}>
  <div class="mika-kumo-stack mika-kumo-stack-tight">
    <Text as="h3" variant="heading3">Discount</Text>
    {cart?.coupon && (
      <div class="mika-kumo-actions">
        <Badge variant="success">{cart.coupon.label ?? cart.coupon.code ?? "Discount applied"}</Badge>
      </div>
    )}
  </div>

  <form class="mika-kumo-form mika-kumo-coupon-form" action={actions.mika.cart.applyCoupon} method="post">
    {cart?.id && <input type="hidden" {...mikaHiddenInput("cartId", cart.id)} />}
    <input type="hidden" {...mikaReturnToInput(returnTo)} />
    <Input label={codeLabel} name="code" autoComplete="off" placeholder="Enter code" />
    <Button type="submit" variant="secondary">{applyLabel}</Button>
  </form>

  {cart?.coupon && (
    <form class="mika-kumo-form" action={actions.mika.cart.removeCoupon} method="post">
      {cart.id && <input type="hidden" {...mikaHiddenInput("cartId", cart.id)} />}
      <input type="hidden" {...mikaReturnToInput(returnTo)} />
      <Button type="submit" variant="secondary">{removeLabel}</Button>
    </form>
  )}
</div>
