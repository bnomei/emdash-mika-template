---
/**
 * Subscription renewal table driven by provider-exposed actions (portal, plan
 * change, renew, cancel) from the signed-in account payload.
 */
import { actions } from "astro:actions";
import { Badge, Banner, Button, Empty, Table, Text } from "@cloudflare/kumo";
import type { SubscriptionDTO } from "@bnomei/emdash-mika/types";
import { mikaReturnTo } from "@bnomei/emdash-mika/astro";
import { mikaReturnToInput } from "../lib/form";
import {
  mikaTemplateStatusLabel,
  mikaTemplateStatusVariant,
  mikaTemplateSubscriptionPeriodLabel
} from "../lib/display";

interface Props {
  subscriptions: readonly SubscriptionDTO[];
  returnTo?: string;
  error?: string;
  headingLabel?: string;
  emptyLabel?: string;
  cancelLabel?: string;
  renewLabel?: string;
  changeLabel?: string;
  portalLabel?: string;
  subscriptionLabel?: string;
  periodEndLabel?: string;
  statusLabel?: string;
  showChangeAction?: boolean;
  changePriceIds?: Readonly<Record<string, string>>;
  class?: string;
  [attribute: string]: unknown;
}

const {
  subscriptions,
  returnTo = mikaReturnTo(Astro.url),
  error,
  headingLabel = "Subscriptions",
  emptyLabel = "No subscriptions.",
  cancelLabel = "Cancel renewal",
  renewLabel = "Renew subscription",
  changeLabel = "Manage plan",
  portalLabel = "Billing portal",
  subscriptionLabel = "Subscription",
  periodEndLabel = "Renewal",
  statusLabel = "Status",
  showChangeAction = false,
  changePriceIds = {},
  class: className,
  ...attrs
} = Astro.props;
const hasEmptySlot = Astro.slots.has("empty");
---

<section {...attrs} data-mika-account-subscriptions class:list={["mika-kumo-stack", className]}>
  <div class="mika-kumo-stack mika-kumo-stack-tight">
    <Text as="h2" variant="heading2"><slot name="heading">{headingLabel}</slot></Text>
    <Text as="p" variant="secondary">Review renewal state and use the billing portal or available subscription actions.</Text>
  </div>
  {error && <Banner variant="error" title="Subscription action failed" description={error} role="alert" />}
  {subscriptions.length ? (
    <div class="mika-kumo-table-scroll">
      <Table>
        <Table.Header>
          <Table.Row>
            <Table.Head>{subscriptionLabel}</Table.Head>
            <Table.Head>{statusLabel}</Table.Head>
            <Table.Head>{periodEndLabel}</Table.Head>
            <Table.Head>Actions</Table.Head>
          </Table.Row>
        </Table.Header>
        <Table.Body>
          {subscriptions.map((subscription) => (
            <Table.Row>
              <Table.Cell className="mika-kumo-table-cell mika-kumo-table-cell-primary" data-label={subscriptionLabel}>
                <strong>{subscription.title}</strong>
              </Table.Cell>
              <Table.Cell className="mika-kumo-table-cell" data-label={statusLabel}>
                <div class="mika-kumo-actions">
                  <Badge appearance="dot" variant={mikaTemplateStatusVariant(subscription.status)}>
                    {mikaTemplateStatusLabel(subscription.status)}
                  </Badge>
                  {subscription.cancelAtPeriodEnd && (
                    <Badge appearance="dot" variant="warning">Cancels at period end</Badge>
                  )}
                </div>
              </Table.Cell>
              <Table.Cell className="mika-kumo-table-cell" data-label={periodEndLabel}>
                {subscription.currentPeriodEnd ? (
                  <time datetime={subscription.currentPeriodEnd}>
                    {mikaTemplateSubscriptionPeriodLabel(subscription)}
                  </time>
                ) : (
                  <span class="mika-kumo-muted">Not scheduled</span>
                )}
              </Table.Cell>
              <Table.Cell className="mika-kumo-table-cell" data-label="Actions">
                <div class="mika-kumo-actions">
                  {subscription.providerActions?.includes("portal") && (
                    <form class="mika-kumo-form" action={actions.mika.account.portal} method="post">
                      <input type="hidden" {...mikaReturnToInput(returnTo)} />
                      <Button type="submit" variant="secondary" aria-label={`${portalLabel} for ${subscription.title}`}>
                        {portalLabel}
                      </Button>
                    </form>
                  )}
                  {showChangeAction && subscription.providerActions?.includes("change") && changePriceIds[subscription.id] && (
                    <form class="mika-kumo-form" action={actions.mika.subscription.change} method="post">
                      <input type="hidden" name="subscriptionId" value={subscription.id} />
                      <input type="hidden" name="priceId" value={changePriceIds[subscription.id] ?? ""} />
                      <input type="hidden" {...mikaReturnToInput(returnTo)} />
                      <Button type="submit" variant="secondary" aria-label={`${changeLabel} ${subscription.title}`}>
                        {changeLabel}
                      </Button>
                    </form>
                  )}
                  {subscription.providerActions?.includes("renew") && (
                    <form class="mika-kumo-form" action={actions.mika.subscription.renew} method="post">
                      <input type="hidden" name="subscriptionId" value={subscription.id} />
                      <input type="hidden" {...mikaReturnToInput(returnTo)} />
                      <Button type="submit" variant="secondary" aria-label={`${renewLabel} ${subscription.title}`}>
                        {renewLabel}
                      </Button>
                    </form>
                  )}
                  {subscription.providerActions?.includes("cancel") && !subscription.cancelAtPeriodEnd && (
                    <form class="mika-kumo-form" action={actions.mika.subscription.cancel} method="post">
                      <input type="hidden" name="subscriptionId" value={subscription.id} />
                      <input type="hidden" {...mikaReturnToInput(returnTo)} />
                      <Button type="submit" variant="secondary-destructive" aria-label={`${cancelLabel} ${subscription.title}`}>
                        {cancelLabel}
                      </Button>
                    </form>
                  )}
                  {!subscription.providerActions?.length && <span class="mika-kumo-muted">Managed by seller</span>}
                </div>
              </Table.Cell>
            </Table.Row>
          ))}
        </Table.Body>
      </Table>
    </div>
  ) : hasEmptySlot ? (
    <slot name="empty" />
  ) : (
    <Empty size="sm" title={emptyLabel} description="Subscription access and renewal details will appear here." />
  )}
</section>
