---
/**
 * Cart line-item table: quantity updates, per-line stock badges, save-for-later,
 * and remove actions bound to Mika cart/wishlist actions.
 */
import { actions } from "astro:actions";
import { Button, Empty, Input, Table } from "@cloudflare/kumo";
import type { CartDTO } from "@bnomei/emdash-mika/types";
import {
  formatMikaMoney,
  formatMikaVariant,
  mikaMaxPurchaseQuantity,
  mikaReturnTo
} from "@bnomei/emdash-mika/astro";
import { mikaHiddenInput, mikaReturnToInput } from "../lib/form";
import StockBadge from "./StockBadge.astro";

interface Props {
  cart?: CartDTO | null;
  returnTo?: string;
  emptyLabel?: string;
  emptyDescription?: string;
  itemLabel?: string;
  quantityLabel?: string;
  lineTotalLabel?: string;
  actionsLabel?: string;
  updateLabel?: string;
  removeLabel?: string;
  saveForLaterLabel?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  cart,
  returnTo = mikaReturnTo(Astro.url),
  emptyLabel = "Cart is empty",
  emptyDescription = "Add a product before checkout.",
  itemLabel = "Item",
  quantityLabel = "Quantity",
  lineTotalLabel = "Line total",
  actionsLabel = "Actions",
  updateLabel = "Update quantity",
  removeLabel = "Remove from cart",
  saveForLaterLabel = "Move to wishlist",
  class: className,
  ...attrs
} = Astro.props;
const hasEmptySlot = Astro.slots.has("empty");
---

<div {...attrs} data-mika-cart-lines class:list={["mika-kumo-stack", className]}>
  {cart?.items.length ? (
    <div class="mika-kumo-table-scroll">
      <Table>
        <Table.Header>
          <Table.Row>
            <Table.Head>{itemLabel}</Table.Head>
            <Table.Head>{quantityLabel}</Table.Head>
            <Table.Head>{lineTotalLabel}</Table.Head>
            <Table.Head>{actionsLabel}</Table.Head>
          </Table.Row>
        </Table.Header>
        <Table.Body>
          {cart.items.map((line) => (
            <Table.Row data-mika-cart-line={line.id}>
              <Table.Cell className="mika-kumo-cart-cell mika-kumo-cart-cell-item" data-label={itemLabel}>
                <div class="mika-kumo-stack mika-kumo-stack-tight mika-kumo-cart-item">
                  <strong class="mika-kumo-cart-item-title">{line.title}</strong>
                  {line.variantOptions.length > 0 && (
                    <small class="mika-kumo-muted">{formatMikaVariant(line.variantOptions)}</small>
                  )}
                  <div class="mika-kumo-cart-item-meta">
                    <StockBadge availability={line.availability} />
                    {line.sku && <small class="mika-kumo-muted">SKU {line.sku}</small>}
                    <small class="mika-kumo-muted">{formatMikaMoney(line.unitAmount)} each</small>
                  </div>
                </div>
              </Table.Cell>
              <Table.Cell className="mika-kumo-cart-cell" data-label={quantityLabel}>
                <form class="mika-kumo-form mika-kumo-inline-form" action={actions.mika.cart.update} method="post">
                  <input type="hidden" {...mikaHiddenInput("lineId", line.id)} />
                  <input type="hidden" {...mikaReturnToInput(returnTo)} />
                  <Input
                    name="quantity"
                    type="number"
                    min="1"
                    max={mikaMaxPurchaseQuantity(line.availability)}
                    inputMode="numeric"
                    defaultValue={String(line.quantity)}
                    aria-label={`${quantityLabel} for ${line.title}`}
                  />
                  <Button
                    type="submit"
                    variant="secondary"
                    aria-label={`${updateLabel} quantity for ${line.title}`}
                  >
                    {updateLabel}
                  </Button>
                </form>
              </Table.Cell>
              <Table.Cell className="mika-kumo-cart-cell" data-label={lineTotalLabel}>
                <output class="mika-kumo-strong">{formatMikaMoney(line.total)}</output>
              </Table.Cell>
              <Table.Cell className="mika-kumo-cart-cell mika-kumo-cart-cell-actions" data-label={actionsLabel}>
                <div class="mika-kumo-actions mika-kumo-cart-line-actions">
                  <form class="mika-kumo-form" action={actions.mika.wishlist.saveForLater} method="post">
                    <input type="hidden" {...mikaHiddenInput("lineId", line.id)} />
                    <input type="hidden" {...mikaReturnToInput(returnTo)} />
                    <Button type="submit" variant="secondary" aria-label={`${saveForLaterLabel} ${line.title}`}>
                      {saveForLaterLabel}
                    </Button>
                  </form>
                  <form class="mika-kumo-form" action={actions.mika.cart.remove} method="post">
                    <input type="hidden" {...mikaHiddenInput("lineId", line.id)} />
                    <input type="hidden" {...mikaReturnToInput(returnTo)} />
                    <Button type="submit" variant="secondary-destructive" aria-label={`${removeLabel} ${line.title}`}>
                      Remove
                    </Button>
                  </form>
                </div>
              </Table.Cell>
            </Table.Row>
          ))}
        </Table.Body>
      </Table>
    </div>
  ) : hasEmptySlot ? (
    <slot name="empty" />
  ) : (
    <Empty size="sm" title={emptyLabel} description={emptyDescription} />
  )}
</div>
