---
import { Badge, Empty, Link, Table, Text } from "@cloudflare/kumo";
import type { DownloadDTO } from "@bnomei/emdash-mika/types";
import {
  mikaTemplateDateLabel,
  mikaTemplateStatusLabel,
  mikaTemplateStatusVariant
} from "../lib/display";

interface AccountDownloadDisplay extends DownloadDTO {
  readonly status?: string;
}

interface Props {
  downloads: readonly AccountDownloadDisplay[];
  headingLabel?: string;
  emptyLabel?: string;
  downloadLabel?: string;
  expiresLabel?: string;
  statusLabel?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  downloads,
  headingLabel = "Downloads",
  emptyLabel = "No downloads.",
  downloadLabel = "Download",
  expiresLabel = "Expires",
  statusLabel = "Status",
  class: className,
  ...attrs
} = Astro.props;
const hasEmptySlot = Astro.slots.has("empty");
---

<section {...attrs} data-mika-account-downloads class:list={["mika-kumo-stack", className]}>
  <div class="mika-kumo-stack mika-kumo-stack-tight">
    <Text as="h2" variant="heading2"><slot name="heading">{headingLabel}</slot></Text>
    <Text as="p" variant="secondary">Download ready files before they expire. Expired files stay visible for reference.</Text>
  </div>
  {downloads.length ? (
    <div class="mika-kumo-table-scroll">
      <Table>
        <Table.Header>
          <Table.Row>
            <Table.Head>{downloadLabel}</Table.Head>
            <Table.Head>{statusLabel}</Table.Head>
            <Table.Head>{expiresLabel}</Table.Head>
            <Table.Head>Action</Table.Head>
          </Table.Row>
        </Table.Header>
        <Table.Body>
          {downloads.map((download) => {
            const status = download.status ?? "ready";
            return (
              <Table.Row>
                <Table.Cell className="mika-kumo-table-cell mika-kumo-table-cell-primary" data-label={downloadLabel}>
                  <strong>{download.title}</strong>
                </Table.Cell>
                <Table.Cell className="mika-kumo-table-cell" data-label={statusLabel}>
                  <Badge appearance="dot" variant={mikaTemplateStatusVariant(status)}>
                    {mikaTemplateStatusLabel(status)}
                  </Badge>
                </Table.Cell>
                <Table.Cell className="mika-kumo-table-cell" data-label={expiresLabel}>
                  {download.expiresAt ? (
                    <time datetime={download.expiresAt}>{mikaTemplateDateLabel(download.expiresAt)}</time>
                  ) : (
                    <span class="mika-kumo-muted">No expiry</span>
                  )}
                </Table.Cell>
                <Table.Cell className="mika-kumo-table-cell" data-label="Action">
                  {status === "expired" ? (
                    <span class="mika-kumo-muted">Expired</span>
                  ) : (
                    <Link href={download.href}>Download now</Link>
                  )}
                </Table.Cell>
              </Table.Row>
            );
          })}
        </Table.Body>
      </Table>
    </div>
  ) : hasEmptySlot ? (
    <slot name="empty" />
  ) : (
    <Empty size="sm" title={emptyLabel} description="Ready downloads will appear here after checkout." />
  )}
</section>
