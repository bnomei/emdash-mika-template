---
/**
 * Full HTML document shell: Kumo theme, `MikaKumoAppFrame` sidebar layout, page
 * header slots, and shared cart/account shortcuts.
 */
import { Badge, Link, Text } from "@cloudflare/kumo";
import MikaKumoAppFrame from "./MikaKumoAppFrame";
import MikaStorefront from "./MikaStorefront.astro";
import "../styles/kumo.css";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  documentTitle?: string;
  backHref?: string;
  backLabel?: string;
  pageSize?: "default" | "narrow";
  cartItemCount?: number;
  storefront?: boolean;
  webmcp?: boolean;
  annotations?: boolean;
  class?: string;
  [attribute: string]: unknown;
}

const {
  title,
  description,
  eyebrow,
  documentTitle = title,
  backHref,
  backLabel = "Back",
  pageSize = "default",
  cartItemCount = 0,
  storefront = true,
  webmcp = storefront,
  annotations = storefront,
  class: className,
  ...attrs
} = Astro.props;
const hasHeaderSlot = Astro.slots.has("header");
const currentPath = Astro.url.pathname;
const cartLabel = cartItemCount > 0 ? `Cart (${cartItemCount})` : "Cart";
---

<html lang="en" data-theme="kumo">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{documentTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <MikaKumoAppFrame
      client:load
      title={title}
      currentPath={currentPath}
      cartItemCount={cartItemCount}
    >
      <main
        {...attrs}
        data-mika-kumo-page
        data-mika-storefront-view="page"
        data-mika-cart-item-count={cartItemCount}
        data-mika-page-size={pageSize}
        class:list={["mika-kumo-page", className]}
      >
        <header class="mika-kumo-header">
          <div class="mika-kumo-title-row">
            <div class="mika-kumo-kicker">
              {backHref && <Link href={backHref}>{backLabel}</Link>}
              {eyebrow && <Badge variant="secondary">{eyebrow}</Badge>}
            </div>
            <nav class="mika-kumo-header-actions" aria-label="Page shortcuts">
              <Link href="/cart" variant="plain" data-mika-cart-badge="header">{cartLabel}</Link>
              <Link href="/account" variant="plain">Account</Link>
            </nav>
          </div>
          <Text as="h1" variant="heading1">{title}</Text>
          {description && (
            <Text as="p" variant="secondary" size="lg">{description}</Text>
          )}
          {hasHeaderSlot && <slot name="header" />}
        </header>
        <slot />
      </main>
    </MikaKumoAppFrame>
    <MikaStorefront enabled={webmcp || annotations} webmcp={webmcp} annotations={annotations} />
  </body>
</html>
