---
/**
 * `cart.add` form with variant/option controls, quantity clamping, and per-sellable
 * availability panels; pairs with `AddToCartFormSync` when pickers are interactive.
 */
import { actions } from "astro:actions";
import { Button, Input } from "@cloudflare/kumo";
import type { SellableDTO } from "@bnomei/emdash-mika/types";
import {
  createMikaPurchaseModel,
  mikaMaxPurchaseQuantity,
  mikaReturnTo
} from "@bnomei/emdash-mika/astro";
import type { MikaPurchaseModel } from "@bnomei/emdash-mika/astro";
import { mikaHiddenInput, mikaReturnToInput } from "../lib/form";
import AddToCartFormSync from "./AddToCartFormSync.astro";
import LowStockNotice from "./LowStockNotice.astro";
import PurchaseOptionsSelect from "./PurchaseOptionsSelect.tsx";
import StockBadge from "./StockBadge.astro";
import UnavailableNotice from "./UnavailableNotice.astro";
import VariantOptionGroups from "./VariantOptionGroups.tsx";
import VariantSelector from "./VariantSelector.astro";

interface Props {
  sellables: readonly SellableDTO[];
  purchase?: MikaPurchaseModel;
  showPurchaseControls?: boolean;
  returnTo?: string;
  quantity?: number;
  buttonLabel?: string;
  outOfStockLabel?: string;
  unavailableLabel?: string;
  chooseOptionLabel?: string;
  purchaseLabel?: string;
  quantityLabel?: string;
  buttonClass?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  sellables,
  purchase: purchaseInput,
  showPurchaseControls = true,
  returnTo = mikaReturnTo(Astro.url),
  quantity = 1,
  buttonLabel = "Add to cart",
  outOfStockLabel = "Out of stock",
  unavailableLabel = "Unavailable",
  chooseOptionLabel = "Choose an available option",
  purchaseLabel = "Purchase",
  quantityLabel = "Quantity",
  buttonClass,
  class: className,
  ...attrs
} = Astro.props;
const purchase = purchaseInput ?? createMikaPurchaseModel(sellables);
const syncAvailabilityPanels =
  !showPurchaseControls || purchase.useGroupedVariantControls || purchase.options.length > 1;
const needsAddToCartSync =
  showPurchaseControls && (purchase.useGroupedVariantControls || purchase.options.length > 1);
const selectedAvailabilityStatus = purchase.selectedSellable?.availability.status;
const disabledButtonLabel = purchase.missingActivePrice
  ? unavailableLabel
  : selectedAvailabilityStatus === "out_of_stock"
    ? outOfStockLabel
    : !purchase.selectedOption && purchase.options.length > 0
      ? chooseOptionLabel
      : unavailableLabel;
const resolvedButtonLabel = purchase.unavailable ? disabledButtonLabel : buttonLabel;
---

<form
  {...attrs}
  data-mika-add-to-cart
  class:list={["mika-kumo-form", className]}
  action={actions.mika.cart.add}
  method="post"
>
  <input type="hidden" {...mikaReturnToInput(returnTo)} />
  {!showPurchaseControls && (
    <>
      <input
        type="hidden"
        {...mikaHiddenInput("sellableId", purchase.selectedSellable?.id)}
        data-mika-selected-sellable-id
      />
      <input
        type="hidden"
        {...mikaHiddenInput("priceId", purchase.selectedPrice?.id)}
        data-mika-selected-price-id
      />
    </>
  )}

  {showPurchaseControls && purchase.useGroupedVariantControls ? (
    <>
      <VariantOptionGroups
        client:load
        variantGroups={purchase.variantGroups}
        variantOptionMap={purchase.variantOptionMap}
        selectedSellableId={purchase.selectedSellable?.id}
        includePriceId
        label={purchaseLabel}
      />
    </>
  ) : showPurchaseControls && purchase.options.length > 1 ? (
    <PurchaseOptionsSelect
      client:load
      label={purchaseLabel}
      name="purchase"
      selectedValue={purchase.options[purchase.selectedOptionIndex]?.fields.purchase}
      options={purchase.options.map((option) => ({
        label: option.label,
        value: option.fields.purchase,
        sellableId: option.fields.sellableId,
        priceId: option.fields.priceId,
        maxQuantity: mikaMaxPurchaseQuantity(option.sellable.availability),
        disabled: option.disabled,
      }))}
    />
  ) : showPurchaseControls && purchase.selectedOption ? (
    <input type="hidden" {...mikaHiddenInput("purchase", purchase.selectedOption.fields.purchase)} />
  ) : showPurchaseControls ? (
    <VariantSelector sellables={purchase.activeSellables} />
  ) : null}

  <Input
    label={quantityLabel}
    name="quantity"
    type="number"
    inputMode="numeric"
    min="1"
    max={purchase.maxQuantity}
    defaultValue={String(quantity)}
    disabled={purchase.unavailable}
    data-mika-purchase-quantity
    data-mika-initial-disabled={purchase.unavailable ? "true" : "false"}
  />

  {syncAvailabilityPanels ? (
    purchase.activeSellables.map((sellable) => (
      <div
        class="mika-kumo-availability"
        data-mika-availability-for={sellable.id}
        hidden={sellable.id !== purchase.selectedSellable?.id}
      >
        <StockBadge availability={sellable.availability} />
        <LowStockNotice availability={sellable.availability} />
        <UnavailableNotice
          availability={sellable.availability}
          show={purchase.missingActivePrice || undefined}
        />
      </div>
    ))
  ) : (
    <>
      {purchase.selectedSellable && (
        <StockBadge availability={purchase.selectedSellable.availability} />
      )}
      {purchase.selectedSellable && (
        <LowStockNotice availability={purchase.selectedSellable.availability} />
      )}
      {purchase.selectedSellable && (
        <UnavailableNotice
          availability={purchase.selectedSellable.availability}
          show={purchase.missingActivePrice || undefined}
        />
      )}
    </>
  )}

  <Button
    type="submit"
    className={buttonClass}
    variant="primary"
    disabled={purchase.unavailable}
    data-mika-purchase-submit
    data-mika-initial-disabled={purchase.unavailable ? "true" : "false"}
    data-mika-enabled-label={buttonLabel}
    data-mika-disabled-label={disabledButtonLabel}
  >
    {resolvedButtonLabel}
  </Button>
</form>

{needsAddToCartSync && <AddToCartFormSync />}
