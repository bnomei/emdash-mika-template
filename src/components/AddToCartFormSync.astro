<script>
  for (const form of document.querySelectorAll("[data-mika-add-to-cart]")) {
    const groups = form.querySelector("[data-mika-variant-groups]");
    if (!groups) continue;

    const sync = (detail = {}) => {
      const sellableId =
        detail.sellableId ?? groups.dataset.mikaSelectedSellableId ?? "";
      const maxQuantity =
        detail.maxQuantity === undefined
          ? groups.dataset.mikaSelectedMaxQuantity ?? ""
          : String(detail.maxQuantity);

      for (const button of form.querySelectorAll("[data-mika-purchase-submit]")) {
        button.disabled =
          sellableId === "" || button.dataset.mikaInitialDisabled === "true";
        if (button.dataset.mikaEnabledLabel && button.dataset.mikaDisabledLabel) {
          button.textContent = button.disabled
            ? button.dataset.mikaDisabledLabel
            : button.dataset.mikaEnabledLabel;
        }
      }

      for (const input of form.querySelectorAll("[data-mika-purchase-quantity]")) {
        input.disabled =
          sellableId === "" || input.dataset.mikaInitialDisabled === "true";
        if (maxQuantity === "") {
          input.removeAttribute("max");
        } else {
          input.setAttribute("max", maxQuantity);
          if (Number(input.value) > Number(maxQuantity)) input.value = maxQuantity;
        }
      }

      for (const panel of form.querySelectorAll("[data-mika-availability-for]")) {
        panel.hidden = panel.dataset.mikaAvailabilityFor !== sellableId;
      }
    };

    groups.addEventListener("mika:variant-change", (event) => sync(event.detail));
    sync();
  }

  for (const form of document.querySelectorAll("[data-mika-add-to-cart]")) {
    const select = form.querySelector("[data-mika-purchase-select]");
    if (!select) continue;

    const syncFromSelect = (detail = {}) => {
      const sellableId =
        detail.sellableId ?? select.dataset.mikaPurchaseSellableId ?? "";
      const maxQuantity =
        detail.maxQuantity === undefined
          ? select.dataset.mikaPurchaseMaxQuantity ?? ""
          : String(detail.maxQuantity);

      for (const button of form.querySelectorAll("[data-mika-purchase-submit]")) {
        button.disabled =
          sellableId === "" || button.dataset.mikaInitialDisabled === "true";
        if (button.dataset.mikaEnabledLabel && button.dataset.mikaDisabledLabel) {
          button.textContent = button.disabled
            ? button.dataset.mikaDisabledLabel
            : button.dataset.mikaEnabledLabel;
        }
      }

      for (const input of form.querySelectorAll("[data-mika-purchase-quantity]")) {
        input.disabled =
          sellableId === "" || input.dataset.mikaInitialDisabled === "true";
        if (maxQuantity === "") {
          input.removeAttribute("max");
        } else {
          input.setAttribute("max", maxQuantity);
          if (Number(input.value) > Number(maxQuantity)) input.value = maxQuantity;
        }
      }

      for (const panel of form.querySelectorAll("[data-mika-availability-for]")) {
        panel.hidden = panel.dataset.mikaAvailabilityFor !== sellableId;
      }
    };

    select.addEventListener("mika:purchase-change", (event) => syncFromSelect(event.detail));
    syncFromSelect();
  }
</script>
