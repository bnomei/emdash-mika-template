---
/**
 * Cart totals definition list (subtotal, discount, tax, shipping, total) for
 * cart and checkout sidebars.
 */
import type { CartDTO } from "@bnomei/emdash-mika/types";
import { formatMikaMoney } from "@bnomei/emdash-mika/astro";

interface Props {
  cart?: CartDTO | null;
  annotationLabel?: string;
  annotationMetadata?: Record<string, string | number | boolean | null>;
  subtotalLabel?: string;
  discountLabel?: string;
  taxLabel?: string;
  shippingLabel?: string;
  totalLabel?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  cart,
  annotationLabel = "Cart totals",
  annotationMetadata = { itemCount: cart?.items.reduce((count, line) => count + line.quantity, 0) ?? 0 },
  subtotalLabel = "Subtotal",
  discountLabel = "Discount",
  taxLabel = "Tax",
  shippingLabel = "Shipping",
  totalLabel = "Total",
  class: className,
  ...attrs
} = Astro.props;
---

<dl {...attrs} data-mika-cart-summary data-mika-annotation={annotationLabel} data-mika-annotation-metadata={annotationMetadata ? JSON.stringify(annotationMetadata) : undefined} class:list={["mika-kumo-summary", className]}>
  <div>
    <dt>{subtotalLabel}</dt>
    <dd>{formatMikaMoney(cart?.subtotal)}</dd>
  </div>
  {cart?.discount && (
    <div>
      <dt>{discountLabel}</dt>
      <dd>{formatMikaMoney(cart.discount)}</dd>
    </div>
  )}
  {cart?.tax && (
    <div>
      <dt>{taxLabel}</dt>
      <dd>{formatMikaMoney(cart.tax)}</dd>
    </div>
  )}
  {cart?.shipping && (
    <div>
      <dt>{shippingLabel}</dt>
      <dd>{formatMikaMoney(cart.shipping)}</dd>
    </div>
  )}
  <div>
    <dt>{totalLabel}</dt>
    <dd>{formatMikaMoney(cart?.total)}</dd>
  </div>
  <div><dt class="mika-kumo-sr-only">Explanation</dt><dd><button type="button" hidden data-mika-annotation-prompt="Explain these cart totals, discounts and any missing checkout costs.">Explain totals</button></dd></div>
</dl>
