---
/**
 * Registers `<mika-product-purchase>` to propagate sellable/price/quantity changes
 * across nested add-to-cart, wishlist, and buy-now forms in one purchase block.
 */
---
<script>
  interface MikaPurchaseChangeDetail {
    sellableId?: string;
    priceId?: string;
    maxQuantity?: number;
  }

  if (!customElements.get("mika-product-purchase")) {
    customElements.define(
      "mika-product-purchase",
      class extends HTMLElement {
        connectedCallback() {
          if (this.dataset.mikaProductPurchaseReady === "true") return;
          this.dataset.mikaProductPurchaseReady = "true";

          const sync = (
            sellableId: string,
            priceId: string,
            maxQuantity: string
          ) => {
            this.querySelectorAll<HTMLInputElement>(
              "[data-mika-selected-sellable-id]"
            ).forEach((input) => {
              input.value = sellableId ?? "";
            });
            this.querySelectorAll<HTMLInputElement>(
              "[data-mika-selected-price-id]"
            ).forEach((input) => {
              input.value = priceId ?? "";
            });
            syncSubmitButtons(this, sellableId ?? "");
            syncQuantityInputs(this, sellableId ?? "", maxQuantity ?? "");
            syncAvailabilityPanels(this, sellableId ?? "");
          };

          const syncSubmitButtons = (scope: HTMLElement, sellableId: string) => {
            for (const button of scope.querySelectorAll<HTMLButtonElement>(
              "[data-mika-purchase-submit]"
            )) {
              button.disabled =
                sellableId === "" ||
                button.dataset.mikaInitialDisabled === "true";
              if (
                button.dataset.mikaEnabledLabel &&
                button.dataset.mikaDisabledLabel
              ) {
                button.textContent = button.disabled
                  ? button.dataset.mikaDisabledLabel
                  : button.dataset.mikaEnabledLabel;
              }
            }
          };

          const syncQuantityInputs = (
            scope: HTMLElement,
            sellableId: string,
            maxQuantity: string
          ) => {
            for (const input of scope.querySelectorAll<HTMLInputElement>(
              "[data-mika-purchase-quantity]"
            )) {
              input.disabled =
                sellableId === "" || input.dataset.mikaInitialDisabled === "true";
              if (maxQuantity === "") {
                input.removeAttribute("max");
              } else {
                input.setAttribute("max", maxQuantity);
                if (Number(input.value) > Number(maxQuantity))
                  input.value = maxQuantity;
              }
            }
            syncBuyNowQuantities(scope);
          };

          const syncBuyNowQuantities = (scope: HTMLElement) => {
            const quantity =
              scope.querySelector<HTMLInputElement>(
                "[data-mika-purchase-quantity]"
              )?.value ?? "1";
            for (const input of scope.querySelectorAll<HTMLInputElement>(
              "[data-mika-buy-now-quantity]"
            )) {
              input.value = quantity;
            }
          };

          const syncAvailabilityPanels = (
            scope: HTMLElement,
            sellableId: string
          ) => {
            for (const panel of scope.querySelectorAll<HTMLElement>(
              "[data-mika-availability-for]"
            )) {
              panel.hidden = panel.dataset.mikaAvailabilityFor !== sellableId;
            }
          };

          const updateFromVariantGroups = (
            groups: HTMLElement,
            detail: MikaPurchaseChangeDetail = {}
          ) => {
            const sellableId =
              detail.sellableId ?? groups.dataset.mikaSelectedSellableId ?? "";
            const priceId =
              detail.priceId ?? groups.dataset.mikaSelectedPriceId ?? "";
            const maxQuantity =
              detail.maxQuantity === undefined
                ? (groups.dataset.mikaSelectedMaxQuantity ?? "")
                : String(detail.maxQuantity);

            sync(sellableId, priceId, maxQuantity);
          };

          const updateFromPurchaseOption = () => {
            const option = this.querySelector<HTMLInputElement>(
              "[data-mika-purchase-option]:checked"
            );
            sync(
              option?.dataset.mikaPurchaseSellableId ?? "",
              option?.dataset.mikaPurchasePriceId ?? "",
              option?.dataset.mikaPurchaseMaxQuantity ?? ""
            );
          };

          const updateFromPurchaseSelect = (
            select: HTMLElement,
            detail: MikaPurchaseChangeDetail = {}
          ) => {
            sync(
              detail.sellableId ?? select.dataset.mikaPurchaseSellableId ?? "",
              detail.priceId ?? select.dataset.mikaPurchasePriceId ?? "",
              detail.maxQuantity === undefined
                ? (select.dataset.mikaPurchaseMaxQuantity ?? "")
                : String(detail.maxQuantity)
            );
          };

          const options = this.querySelectorAll<HTMLInputElement>(
            "[data-mika-purchase-option]"
          );
          for (const option of options) {
            option.addEventListener("change", updateFromPurchaseOption);
          }
          if (options.length > 0) updateFromPurchaseOption();

          for (const select of this.querySelectorAll<HTMLElement>(
            "[data-mika-purchase-select]"
          )) {
            select.addEventListener("mika:purchase-change", (event) =>
              updateFromPurchaseSelect(
                select,
                (event as CustomEvent<MikaPurchaseChangeDetail>).detail
              )
            );
            updateFromPurchaseSelect(select);
          }

          for (const groups of this.querySelectorAll<HTMLElement>(
            "[data-mika-variant-groups]"
          )) {
            groups.addEventListener("mika:variant-change", (event) =>
              updateFromVariantGroups(
                groups,
                (event as CustomEvent<MikaPurchaseChangeDetail>).detail
              )
            );
            updateFromVariantGroups(groups);
          }

          for (const input of this.querySelectorAll<HTMLInputElement>(
            "[data-mika-purchase-quantity]"
          )) {
            if (input.dataset.mikaBuyNowQuantitySyncReady === "true") continue;
            input.dataset.mikaBuyNowQuantitySyncReady = "true";
            input.addEventListener("input", () => syncBuyNowQuantities(this));
          }
          syncBuyNowQuantities(this);
        }
      }
    );
  }
</script>
