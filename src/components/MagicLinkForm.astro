---
/**
 * Passwordless sign-in request form posting to `magicLink.request` with
 * accessible email error wiring and `returnTo` redirect preservation.
 */
import { actions } from "astro:actions";
import { Button, Input } from "@cloudflare/kumo";
import { mikaReturnToInput } from "../lib/form";
import { mikaTemplateRoutes } from "../lib/routes";

interface Props {
  id?: string;
  returnTo?: string;
  label?: string;
  emailLabel?: string;
  emailValue?: string;
  emailId?: string;
  emailError?: string;
  emailErrorId?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  id: formId,
  returnTo = mikaTemplateRoutes.account,
  label = "Send link",
  emailLabel = "Email",
  emailValue = "",
  emailId,
  emailError,
  emailErrorId,
  class: className,
  ...attrs
} = Astro.props;
const resolvedEmailId = emailId ?? (formId ? `${formId}-email` : "mika-magic-link-email");
const resolvedEmailErrorId = emailError
  ? emailErrorId ?? `${resolvedEmailId}-error`
  : undefined;
---

<form
  {...attrs}
  id={formId}
  data-mika-magic-link
  class:list={["mika-kumo-form", className]}
  action={actions.mika.magicLink.request.queryString}
  method="post"
>
  <input type="hidden" {...mikaReturnToInput(returnTo)} />
  <Input
    label={emailLabel}
    id={resolvedEmailId}
    name="email"
    type="email"
    autoComplete="email"
    required
    defaultValue={emailValue}
    aria-invalid={emailError ? "true" : undefined}
    aria-describedby={resolvedEmailErrorId}
  />
  {emailError && (
    <p id={resolvedEmailErrorId} role="alert">
      {emailError}
    </p>
  )}
  <Button type="submit" variant="primary">{label}</Button>
</form>
